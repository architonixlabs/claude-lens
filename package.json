{
  "name": "claude-lens",
  "version": "0.1.0",
  "private": true,
  "description": "ClaudeLens — a read-only live map & timeline debugger for Claude Code / Agent SDK multi-agent runs: orchestrator, subagents, skills, tools, tokens, errors — across every session.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "claude", "claude-code", "anthropic", "agents", "multi-agent", "observability",
    "visualization", "debugging", "agent-sdk", "hooks"
  ],
  "bin": {
    "claude-lens": "server/index.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "demo": "node server/index.js --demo",
    "sim": "node sim/simulator.js",
    "install-hooks": "node hooks/install-hooks.mjs",
    "uninstall-hooks": "node hooks/install-hooks.mjs --remove",
    "test": "playwright test",
    "test:unit": "node --test tests/*.test.mjs",
    "test:headed": "playwright test --headed",
    "stress": "node sim/stress.js",
    "postinstall-note": "run: npx playwright install chromium"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  },
  "engines": {
    "node": ">=18"
  }
}
